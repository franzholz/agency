{
  "name": "jambagecom/agency",
  "type": "typo3-cms-extension",
  "description": "Agency Registration. - An improved variant of Kasper Skårhøj's Front End User Admin extension",
  "keywords": [
    "TYPO3",
    "extension",
    "frontend user",
    "registration"
  ],
  "support": {
    "issues": "https://github.com/franzholz/agency/issues"
  },
  "homepage": "https://jambage.com",
  "authors": [
    {
      "name": "Franz Holzinger",
      "role": "Developer",
      "homepage": "https://ttproducts.de"
    }
  ],
  "license": [
    "GPL-2.0-or-later"
  ],
  "require": {
    "typo3/cms-core": "^13.4 || ^14.3",
    "jambagecom/div2007": "^2.4.4",
    "friendsoftypo3/rdct": "^3.2"
  },
  "suggest": {
    "typo3/cms-felogin": "^13.4 || ^14.3",
    "sjbr/static-info-tables": "^13.4 || ^14.3"
  },
  "autoload": {
    "psr-4": {
      "JambageCom\\Agency\\": "Classes"
    }
  },
  "replace": {
    "typo3-ter/agency": "self.version"
  },
  "extra": {
    "typo3/cms": {
      "extension-key": "agency",
      "version": "1.1.2",
      "Package": {
          "providesPackages": {}
      }
    }
  },
  "config": {
      "allow-plugins": {
          "typo3/class-alias-loader": true,
          "typo3/cms-composer-installers": true
      }
  }
}

